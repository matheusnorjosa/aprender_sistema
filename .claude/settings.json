{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(python manage.py:*)",
      "Bash(docker compose:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker build:*)",
      "Bash(docker tag:*)",
      "Bash(docker rmi:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "additionalDirectories": []
  },
  "env": {
    "DJANGO_ENV": "development",
    "DB_HOST": "db",
    "DB_PORT": "5432"
  },
  "enableAllProjectMcpServers": true,
  "verbose": false
}