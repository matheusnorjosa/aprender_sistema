{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(done)",
      "Bash(for f in v2/docs/*.md)",
      "Bash(do echo \"=== $f ===\")",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(cmd.exe /c \"where gh\")",
      "Bash(cmd.exe /c \"gh --version && exit\")",
      "Bash(docker:*)",
      "Bash(ForEach-Object { docker rmi -f $_ })",
      "Bash(xargs -r docker rmi -f)",
      "Bash(xargs -r docker rm -f)",
      "Bash(cp:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(taskkill:*)",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "markitdown",
    "django-aprender",
    "fastmcp-aprender"
  ]
}
