{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pre-commit run:*)",
      "Bash(pip install:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(git checkout:*)",
      "Bash(python:*)",
      "Bash(rm:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(timeout 15 docker compose exec -T web python manage.py check --deploy)",
      "Bash(docker volume:*)",
      "Bash(sed:*)",
      "Bash(mv:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "markitdown",
    "django-aprender",
    "fastmcp-aprender"
  ]
}
