# =============================================================================
# SISTEMA APRENDER - VARIÁVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env e configure as variáveis para seu ambiente

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# OBRIGATÓRIO: Chave secreta única para sua instalação
# Gere uma nova chave: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-minimum-50-chars-abcdefghijk

# Modo de desenvolvimento (True apenas em desenvolvimento)
DEBUG=False

# Domínios permitidos (separados por vírgula)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# =============================================================================
# BANCO DE DADOS
# =============================================================================

# Para produção com PostgreSQL, configure DATABASE_URL
# DATABASE_URL=postgres://usuario:senha@localhost:5432/aprender_sistema

# Alternativamente, configure variáveis individuais:
# DB_NAME=aprender_sistema
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# INTEGRAÇÃO GOOGLE CALENDAR
# =============================================================================

# Habilitar sincronização com Google Calendar (1 para ativar, 0 para desativar)
FEATURE_GOOGLE_SYNC=1

# Caminho para o arquivo de credenciais do Service Account
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json

# ID do calendário Google a ser usado
GOOGLE_CALENDAR_CALENDAR_ID=primary

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA (PRODUÇÃO)
# =============================================================================

# Forçar HTTPS
SECURE_SSL_REDIRECT=1

# Cookies seguros
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# =============================================================================
# CACHE (OPCIONAL - REDIS)
# =============================================================================

# URL do Redis para cache
# REDIS_URL=redis://localhost:6379/1
# CACHE_TTL=300

# =============================================================================
# EMAIL (OPCIONAL)
# =============================================================================

# Backend de email (SMTP padrão)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configurações SMTP (Gmail exemplo)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@domain.com
# EMAIL_HOST_PASSWORD=your-app-password

# Endereço padrão do remetente
# DEFAULT_FROM_EMAIL=Sistema Aprender <noreply@yourdomain.com>

# =============================================================================
# LOGGING (OPCIONAL)
# =============================================================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Caminho para arquivo de log
# LOG_FILE=/var/log/aprender_sistema/app.log

# =============================================================================
# ARMAZENAMENTO DE ARQUIVOS (OPCIONAL)
# =============================================================================

# Para armazenamento em AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Para arquivos estáticos locais
# STATIC_ROOT=/app/staticfiles
# MEDIA_ROOT=/app/media

# =============================================================================
# CONFIGURAÇÕES ESPECÍFICAS DO SISTEMA
# =============================================================================

# Timezone
TIME_ZONE=America/Sao_Paulo

# Idioma
LANGUAGE_CODE=pt-br

# Limite de paginação padrão
DEFAULT_PAGE_SIZE=25

# =============================================================================
# DESENVOLVIMENTO (APENAS EM DEV)
# =============================================================================

# Para desenvolvimento, você pode usar:
# DEBUG=True
# ALLOWED_HOSTS=*
# SECRET_KEY=dev-key-not-secure
# DATABASE_URL=sqlite:///db.sqlite3

# =============================================================================
# EXEMPLO DE COMANDOS ÚTEIS
# =============================================================================

# Teste de configuração Google Calendar:
# python manage.py calendar_check --write-test

# Teste de conectividade de banco:
# python manage.py check --database

# Coletar arquivos estáticos:
# python manage.py collectstatic

# Aplicar migrações:
# python manage.py migrate

# Criar superusuário:
# python manage.py createsuperuser

# Configurar grupos e permissões:
# python manage.py setup_groups