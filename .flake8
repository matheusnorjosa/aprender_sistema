[flake8]
# Black compatibility - 88 chars
max-line-length = 88

exclude = 
    migrations,
    __pycache__,
    manage.py,
    venv,
    .venv,
    staticfiles,
    media,
    logs,
    out,
    temp,
    node_modules,
    .git

# Black compatibility ignores
ignore = 
    E203,
    W503,
    E501,
    W391

# Django and project specific ignores
per-file-ignores =
    __init__.py:F401,F403
    */views/__init__.py:F401,F403
    */migrations/*.py:E501,E402
    settings*.py:F401,E402
    manage.py:F401

# Complexity threshold
max-complexity = 12

# Enable specific checks
select = E,W,F,C,N

# Documentation checks
docstring-convention = google

# Security and quality checks
enable-extensions = 
    G,
    B,
    S,
    DUO

# Line counting
count = True
statistics = True
tee = True