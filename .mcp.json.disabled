{
  "mcpServers": {
    "django-v2": {
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "aprender_v2",
        "-f",
        "v2/infra/docker-compose.yml",
        "exec",
        "-T",
        "web",
        "python",
        "manage.py",
        "stdio_server"
      ],
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings"
      }
    }
  }
}
