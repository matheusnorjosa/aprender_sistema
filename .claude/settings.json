{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(python manage.py:*)",
      "Bash(docker compose:*)",
      "Bash(for:*)",
      "Bash(gh pr list:*)",
      "Bash(git merge:*)",
      "Bash(__NEW_LINE__ echo '=== RESUMO DA ORGANIZAÇÃO ===' echo echo '📁 Raiz do Projeto:' ls -1 *.md)",
      "Bash(sed:*)",
      "Bash(sed:*)",
      "Bash(__NEW_LINE__ echo \"=== ORGANIZAÇÃO COMPLETA ===\"  echo \"\" echo \"Raiz (.):\" find . -maxdepth 1 -name \"*.md\" -type f)",
      "Bash(__NEW_LINE__ echo '=== ORGANIZAÇÃO COMPLETA ===' echo echo 'Raiz (apenas README.md):' ls *.md)",
      "Bash(head -5 echo echo 'v2/docs/ (arquivos principais):' ls v2/docs/*.md)",
      "Bash(xargs -n1 basename echo echo 'v2/docs/memoria/ (histórico):' ls v2/docs/memoria/*.md)",
      "Bash(xargs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker build:*)",
      "Bash(docker tag:*)",
      "Bash(docker rmi:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "additionalDirectories": [
      "C:\\Users\\datsu\\OneDrive\\Documentos\\Aprender Sistema\\📄 v2\\docs\\memoria"
    ]
  },
  "env": {
    "DJANGO_ENV": "development",
    "DB_HOST": "db",
    "DB_PORT": "5432"
  },
  "hooks": {
    "PostToolUse": [
      {
        "description": "Notificação sonora ao completar testes (pytest)",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"if ($env:TOOL_INPUT -match 'pytest') { [console]::beep(800,300); [console]::beep(1000,200) }\""
          }
        ]
      },
      {
        "description": "Notificação sonora ao completar ETL apply",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"if ($env:TOOL_INPUT -match '--apply') { [console]::beep(800,300); [console]::beep(1000,200) }\""
          }
        ]
      },
      {
        "description": "Notificação sonora ao completar docker compose up",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"if ($env:TOOL_INPUT -match 'docker compose up') { [console]::beep(600,200); [console]::beep(800,200) }\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "description": "Notificação geral de sucesso",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[console]::beep(1000,150)\""
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "verbose": false,
  "includeCoAuthoredBy": false
}