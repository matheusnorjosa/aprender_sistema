{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(docker exec:*)",
      "Bash(docker-compose:*)",
      "Bash(curl:*)",
      "Bash(python:*)",
      "Bash(docker:*)",
      "Bash(dir:*)",
      "Bash(git rm:*)",
      "Bash(test:*)",
      "Bash(git grep:*)",
      "Bash(findstr:*)",
      "Bash(sed:*)",
      "Bash(rm:*)",
      "Bash(git tag:*)",
      "Bash(git apply:*)",
      "Bash(grep:*)",
      "Bash(while read u)",
      "Bash(do printf \"GET %s -> \" \"$u\")",
      "Bash(done)",
      "Bash(tee:*)",
      "Bash(git rev-parse --short HEAD)",
      "Bash(git rev-parse:*)",
      "Bash(do echo \">>> $u\")",
      "Bash(pwsh:*)",
      "Bash(powershell.exe:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "markitdown",
    "django-aprender",
    "fastmcp-aprender"
  ]
}
