# -----------------------------------------------------------------------------
# Ambiente de homologacao (STAGING)
# -----------------------------------------------------------------------------
# Uso recomendado:
#   docker compose -p aprender_staging --env-file .env.staging \
#     -f docker-compose.yml up -d
#
# Observacao:
# - Para deploy em VM de staging, usar imagem publicada no Docker Hub.
# - Este arquivo e um template (sem segredos reais).

APP_ENV_FILE=.env.staging
IMAGE_TAG=latest

ENVIRONMENT=staging
DEBUG=0
SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY
REQUIRE_DOCKER=1

ALLOWED_HOSTS=localhost,127.0.0.1,staging.aprender.local,web
CORS_ALLOWED_ORIGINS=https://staging.aprender.local
CSRF_TRUSTED_ORIGINS=https://staging.aprender.local

# Banco de dados
DB_NAME=aprender_db
DB_USER=aprender_user
DB_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=aprender_db
POSTGRES_USER=aprender_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Google Calendar
GCAL_CLIENT=fake
GCAL_SEND_UPDATES=none
FEATURE_AUTO_APPLY_ENABLED=0

