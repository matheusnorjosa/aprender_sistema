[flake8]
max-line-length = 120
extend-ignore = E203, W503, E501, E228, W291, W292, W391, E302, E306, E128, E261
exclude =
    .venv,
    venv,
    migrations,
    __pycache__,
    *.pyi
per-file-ignores =
    __init__.py:F401
    conftest.py:F401,F811
    */tests/*.py:F401,F811,F841
    */views*.py:F401
    */serializers*.py:F401
    */models*.py:F401
    */services*.py:F401,F841
    */management/commands/*.py:F401,F841
