FROM python:3.12-slim

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Copy runtime requirements first for better layer caching.
COPY backend/requirements.txt /app/requirements.txt

# Install Python dependencies, then remove explicit developer-only packages.
RUN pip install --no-cache-dir -r /app/requirements.txt \
 && for pkg in \
    bandit black factory-boy faker flake8 ipdb ipython isort locust mypy \
    pgcli pylint pytest pytest-cov pytest-django pytest-watch pytest-xdist; do \
      if pip show "$pkg" > /dev/null 2>&1; then pip uninstall -y "$pkg"; fi; \
    done

# Runtime OS packages only (no editor/CLI dev stack).
# - postgresql-client: required for backup scripts (Issue #562 C-05)
# - libmagic1: required by python-magic at runtime.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
    curl tzdata ca-certificates libpq5 postgresql-client libmagic1 \
 && rm -rf /var/lib/apt/lists/*

COPY backend /app

RUN mkdir -p /app/infra
COPY infra/gunicorn.conf.py /app/infra/gunicorn.conf.py
COPY infra/scripts /app/infra/scripts
RUN chmod +x /app/infra/scripts/*.sh

ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
RUN python - <<'PY2'
import json
import os

with open("/app/BUILD_INFO.json", "w", encoding="utf-8") as f:
    json.dump(
        {
            "git_sha": os.environ.get("GIT_SHA", "unknown"),
            "build_date": os.environ.get("BUILD_DATE", "unknown"),
            "profile": "prod",
            "note": "Production runtime image (lean).",
        },
        f,
        indent=2,
    )
print("Wrote /app/BUILD_INFO.json")
PY2

CMD ["gunicorn", "config.wsgi:application", "--config", "/app/infra/gunicorn.conf.py"]
