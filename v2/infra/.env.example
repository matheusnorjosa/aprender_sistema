# v2/infra/.env.example — exemplo para desenvolvimento local

# Ambiente
ENVIRONMENT=development
DEBUG=1
SECRET_KEY=django-insecure-dev-key-CHANGE-IN-PRODUCTION

# Banco de dados (container "db")
DB_NAME=aprender_db
DB_USER=aprender_user
DB_PASSWORD=aprender_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Gunicorn (CP1 - Performance Optimization)
# Workers: número de processos (default: CPU count)
# Threads: threads por worker para I/O-bound workload (default: 2)
# Timeout: tempo máximo por request em segundos (default: 120s para ETL)
# Max Requests: recicla workers após N requests (previne memory leaks)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
GUNICORN_MAX_REQUESTS=1000
GUNICORN_BIND=0.0.0.0:8000

# Google Calendar (seguro por padrão em dev)
GCAL_CLIENT=fake
GCAL_SEND_UPDATES=none
GCAL_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fase 3: Auto-apply GCal desativado (governança via /pre-agenda)
FEATURE_AUTO_APPLY_ENABLED=0

# Impedir execução fora do Docker (v2 only)
REQUIRE_DOCKER=1

# Nome do projeto Compose (padronizado)
COMPOSE_PROJECT_NAME=aprender_v2

