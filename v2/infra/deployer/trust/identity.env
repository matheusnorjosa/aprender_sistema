# trust/identity.env — ANCORAS DE IDENTIDADE (tratadas como CODIGO, nao config).
#
# Ficam sob /opt/aprender-deployer/current/trust/ (read-only + chattr +i), NUNCA
# em /etc. Sao a raiz de confianca da verificacao: se um atacante puder editar
# isto, pode apontar a verificacao para uma identidade que ele controla. Por isso
# vivem com o codigo pinado, imutaveis.
#
# ADR-018 Fase 1 · issue #1513

# Emissor OIDC do GitHub Actions (keyless Fulcio).
OIDC_ISSUER="https://token.actions.githubusercontent.com"

# Repo e imagens (allowlist — o ponteiro so pode apontar para estes repos).
GH_REPO="matheusnorjosa/aprender_sistema"
BACKEND_REPO="norjosamatheus/aprender-backend"
FRONTEND_REPO="norjosamatheus/aprender-frontend"

# Identidade que assina o PONTEIRO (promote.yml — criado na Fase 2). So refs/heads/main.
POINTER_IDENTITY_RE='^https://github\.com/matheusnorjosa/aprender_sistema/\.github/workflows/promote\.yml@refs/heads/main$'

# Identidade que assina as IMAGENS (slsa-provenance.yml, ja existe). main ou tags.
IMAGE_IDENTITY_RE='^https://github\.com/matheusnorjosa/aprender_sistema/\.github/workflows/slsa-provenance\.yml@refs/(heads/main|tags/.+)$'

# Workflow assinante para `gh attestation verify --signer-workflow`.
SIGNER_WORKFLOW="matheusnorjosa/aprender_sistema/.github/workflows/slsa-provenance.yml"
