# -----------------------------------------------------------------------------
# Ambiente de producao (PRODUCAO) - TEMPLATE PUBLICO
# -----------------------------------------------------------------------------
# Uso recomendado:
#   IMAGE_TAG=latest docker compose --env-file .env.production \
#     -f docker-compose.prod.yml up -d
#
# IMPORTANTE:
# - Arquivo somente template.
# - Nunca versionar segredos reais.

COMPOSE_PROJECT_NAME=aprender_prod
APP_ENV_FILE=.env.production
# Tag publicada (promocao controlada pelo workflow)
IMAGE_TAG=latest
# Porta publicada do backend (VM01 padrao: 8000)
BACKEND_HOST_PORT=8000
FRONTEND_PORT=81
DOCKER_HUB_TOKEN=CHANGE_ME_DOCKER_HUB_TOKEN
WATCHTOWER_TOKEN=CHANGE_ME_WATCHTOWER_TOKEN

ENVIRONMENT=production
DEBUG=0
SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY
REQUIRE_DOCKER=1

ALLOWED_HOSTS=app.exemplo.com.br,localhost
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://app.exemplo.com.br

# Banco de dados (externo)
DB_NAME=aprender_db
DB_USER=aprender_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
DB_HOST=db.externo.local
DB_PORT=5432

# Redis (externo)
REDIS_HOST=redis.externo.local
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Calendar
GCAL_CLIENT=google
GCAL_SEND_UPDATES=none
FEATURE_AUTO_APPLY_ENABLED=0
