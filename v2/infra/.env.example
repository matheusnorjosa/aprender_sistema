# v2/infra/.env.example — exemplo para desenvolvimento local

# Ambiente
ENVIRONMENT=development
DEBUG=1
SECRET_KEY=django-insecure-dev-key-CHANGE-IN-PRODUCTION

# Banco de dados (container "db")
DB_NAME=aprender_db
DB_USER=aprender_user
DB_PASSWORD=aprender_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Sessões Redis (CP2 - Performance + Security)
# Age: tempo de vida da sessão em segundos (default: 30 minutos)
# Save Every Request: renova sessão a cada request (evita expiração durante uso)
# Expire at Browser Close: sessão expira ao fechar navegador (segurança)
# Cookie Name: nome customizado do cookie de sessão
SESSION_COOKIE_AGE=1800              # 30 minutos (vs 2 semanas default)
SESSION_SAVE_EVERY_REQUEST=True      # Renova a cada request
SESSION_EXPIRE_AT_BROWSER_CLOSE=True # Expira ao fechar browser
SESSION_COOKIE_NAME=asv2sid          # Custom name

# Gunicorn (CP1 - Performance Optimization)
# Workers: número de processos (default: CPU count)
# Threads: threads por worker para I/O-bound workload (default: 2)
# Timeout: tempo máximo por request em segundos (default: 120s para ETL)
# Max Requests: recicla workers após N requests (previne memory leaks)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
GUNICORN_MAX_REQUESTS=1000
GUNICORN_BIND=0.0.0.0:8000

# Sentry APM (MP3 - Distributed Tracing & Error Tracking)
# DSN: Data Source Name do projeto Sentry (obter em sentry.io)
# Traces Sample Rate: % de transactions para tracing (0.0 a 1.0)
# Profiles Sample Rate: % de requests para profiling (0.0 a 1.0, experimental)
# GIT_COMMIT_SHA: SHA do commit para release tracking (set automaticamente no CI/CD)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
GIT_COMMIT_SHA=

# Google Calendar (seguro por padrão em dev)
GCAL_CLIENT=fake
GCAL_SEND_UPDATES=none
GCAL_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fase 3: Auto-apply GCal desativado (governança via /pre-agenda)
FEATURE_AUTO_APPLY_ENABLED=0

# Impedir execução fora do Docker (v2 only)
REQUIRE_DOCKER=1

# Nome do projeto Compose (padronizado)
COMPOSE_PROJECT_NAME=aprender_v2

# Automated Backups (MP5 - Backup System)
# Dir: diretório de backup no container (default: /backups)
# Retention: dias de retenção de backups (default: 7)
# S3 Bucket: bucket S3 para upload (opcional, deixe vazio para backups locais apenas)
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=

