[
  {
    "name": "JS Bundle (gzipped, excluding lazy chunks)",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/brazil-states-*.js"
    ],
    "gzip": true,
    "limit": "650 KB",
    "running": false
  },
  {
    "name": "CSS Bundle (gzipped)",
    "path": "dist/assets/*.css",
    "gzip": true,
    "limit": "50 KB",
    "running": false
  },
  {
    "name": "Main JS Chunk",
    "path": "dist/assets/index-*.js",
    "gzip": true,
    "limit": "150 KB",
    "running": false
  },
  {
    "name": "Vendor Chunk (React + Ant Design)",
    "path": "dist/assets/vendor-*.js",
    "gzip": true,
    "limit": "550 KB",
    "running": false
  },
  {
    "name": "Lazy GeoJSON Chunk",
    "path": "dist/assets/brazil-states-*.js",
    "gzip": true,
    "limit": "100 KB",
    "running": false
  },
  {
    "name": "Total Initial Load",
    "path": [
      "dist/assets/index-*.js",
      "dist/assets/index-*.css"
    ],
    "gzip": true,
    "limit": "200 KB",
    "running": false
  }
]
