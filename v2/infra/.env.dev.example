# -----------------------------------------------------------------------------
# Ambiente local de desenvolvimento (DEV) - TEMPLATE
# -----------------------------------------------------------------------------
# Uso recomendado:
#   docker compose --env-file .env.dev \
#     -f docker-compose.yml -f docker-compose.override.yml up -d

COMPOSE_PROJECT_NAME=aprender_dev
APP_ENV_FILE=.env.dev
IMAGE_TAG=latest

ENVIRONMENT=development
DEBUG=1
SECRET_KEY=CHANGE_ME_DEV_SECRET_KEY
REQUIRE_DOCKER=1

# Rede local
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Banco de dados
DB_NAME=aprender_db
DB_USER=aprender_user
DB_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD
DB_HOST=db
DB_PORT=5432
# Portas publicadas no host (evita colisao entre stacks)
DB_HOST_PORT=5434
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8002
FRONTEND_HOST_PORT=5173
POSTGRES_DB=aprender_db
POSTGRES_USER=aprender_user
POSTGRES_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Google Calendar
GCAL_CLIENT=fake
GCAL_SEND_UPDATES=none
FEATURE_AUTO_APPLY_ENABLED=0
